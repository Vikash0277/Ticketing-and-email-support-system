          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login-password", "host": ["{{baseUrl}}"], "path": ["auth", "login-password"] },
            "description": "Saves accessToken, refreshToken and the current user id. Change customerEmail to adminEmail or agentEmail to test other roles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "pm.collectionVariables.set('userId', body.data.user.id || body.data.user._id);"
