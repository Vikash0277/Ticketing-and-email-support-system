    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Cannot sign in after password reset\",\n  \"description\": \"I reset my password but still receive an error when signing in.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"priority\": \"high\",\n  \"tags\": [\"login\", \"auth\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] },
            "description": "Also accepts multipart/form-data with an `attachments` field (max 5 files, 10 MB each)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data?._id) pm.collectionVariables.set('ticketId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create ticket with attachment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "subject", "value": "Screenshot attached", "type": "text" },
                { "key": "description", "value": "The error is shown in the attached screenshot.", "type": "text" },
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "priority", "value": "medium", "type": "text" },
                { "key": "attachments", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?._id) pm.collectionVariables.set('ticketId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets?page=1&limit=20&view=all&sortBy=updatedAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "view", "value": "all" },
                { "key": "sortBy", "value": "updatedAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            },
            "description": "Optional filters: status, priority, categoryId, assignedTo, requesterId, search, tags, dateFrom, dateTo, view (all|mine|unassigned|overdue)."
          }
        },
        {
          "name": "Ticket stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tickets/stats", "host": ["{{baseUrl}}"], "path": ["tickets", "stats"] }
          }
        },
        {
          "name": "Get ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}"]
            }
          }
        },
        {
          "name": "Update ticket",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"urgent\",\n  \"tags\": [\"login\", \"escalated\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}"]
            },
            "description": "Customers may update subject, description and tags; staff may also change category and priority."
          }
        },
        {
          "name": "Assign ticket",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedTo\": \"{{agentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "assign"]
            },
            "description": "Run Users → List agents first to populate agentId. Send null to unassign."
          }
        },
        {
          "name": "Change status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"pending\",\n  \"note\": \"Waiting for the customer to confirm the reset email.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "status"]
            },
            "description": "Valid statuses: open, in_progress, pending, resolved, closed, reopened. Invalid transitions return 400."
          }
        },
        {
          "name": "Resolve ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Password reset completed and verified.\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "resolve"]
            }
          }
        },
        {
          "name": "Reopen ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"The issue returned after a day.\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/reopen",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "reopen"]
            }
          }
        },
        {
          "name": "Close ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Confirmed with the customer.\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "close"]
            }
          }
        }
      ]
    },
