# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ticketingSystem

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
TOKEN_HASH_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="Support Desk" <support@yourdomain.com>
# Receiving domain configured in Resend (MX record), e.g. replies.yourdomain.com
EMAIL_REPLY_DOMAIN=replies.yourdomain.com
EMAIL_REPLY_TOKEN_SECRET=replace-with-a-long-random-string
# Svix signing secret from the Resend webhook dashboard
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Attachments (Cloudinary). Leave blank to use local disk storage in development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bitmax-tickets

# Logging
LOG_LEVEL=http
